<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="maze_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
    	<uri>model://maze</uri>
    </include>
    <!-- Ground-truth poses on /gazebo/model_states and /gazebo/link_states.
         Needed to evaluate navigation: wheel odometry drifts, and the pose
         printed by `gz model -m mir_robot -i` is NOT base_footprint (it is
         offset by ~2 m / 18 deg), so neither can be used as a reference.
         Read link_states entry "mir_robot::base_footprint" instead. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>
    <model name='marker_0001'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://marker_0001/meshes/marker_0001.dae</uri>
              <scale>2 2 2</scale>
            </mesh>
          </geometry>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <pose>7.62 -1.0 -0.01 0 1.57 3.14</pose>
    </model>
  </world>
</sdf>
